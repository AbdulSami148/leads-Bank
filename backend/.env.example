# Application settings — copy to backend/.env and fill in real values.

# Supabase project credentials
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key      # server-side only — never send to clients

# CORS origin allowed to call this API
FRONTEND_ORIGIN=http://localhost:5173

# Serper.dev API key — used for lead discovery (Google search)
SERPER_API_KEY=your-serper-api-key

# Apify — profile-details enrichment actor (Instagram scrape)
APIFY_API_TOKEN=your-apify-token
APIFY_ACTOR_ID=actor-owner/actor-name

# Google service account used for Sheets writes (never print or log these values)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# Optional: raw service-account key JSON for deployment — wins over the file above
GOOGLE_SERVICE_ACCOUNT_JSON=
